# ---------------------------------------------------
# Server configuration
# ---------------------------------------------------
SERVER_PORT=8080
SERVER_HOST=0.0.0.0

# Comma separated list of origins allowed to call the API from the browser.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------------------------------------------------
# Auth / session cookie configuration
# ---------------------------------------------------
# Set to "true" once the app is served over HTTPS - browsers silently drop
# Secure cookies over plain http://, so this stays "false" for local dev.
COOKIE_SECURE=false

# ---------------------------------------------------
# MySQL database configuration
# ---------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=task_user
DB_PASSWORD=task_password
DB_NAME=task_manager
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_MIN=5
